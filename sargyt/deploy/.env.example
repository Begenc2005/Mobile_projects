NODE_ENV=production
PUBLIC_URL=https://api.sargyt.tm
JWT_SECRET=заменить-на-длинную-случайную-строку
DB_PASSWORD=заменить
ADMIN_PHONES=+99365000000
DEFAULT_COMMISSION_PCT=12
DEV_OTP=0
# SMS-шлюз оператора (шаблон URL с {phone} и {text})
SMS_PROVIDER=http
SMS_HTTP_URL=https://sms.example.tm/send?to={phone}&text={text}
SMS_HTTP_TOKEN=
# Эквайринг банка (данные выдаёт банк по договору)
PAYMENT_PROVIDER=rbs
PAYMENT_BASE_URL=https://<шлюз-банка>/payment/rest
PAYMENT_USER=
PAYMENT_PASSWORD=
PAYMENT_CURRENCY=934
