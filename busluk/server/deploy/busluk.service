[Unit]
Description=Busluk marketplace API
After=network.target postgresql.service

[Service]
User=busluk
EnvironmentFile=/etc/busluk.env
ExecStart=/usr/local/bin/busluk
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/busluk

[Install]
WantedBy=multi-user.target
