# ===== Buşluk: настройки сервера =====
ADDR=127.0.0.1:8080
PUBLIC_URL=https://busluk.tm
DB_URL=postgres://busluk:ПАРОЛЬ@127.0.0.1/busluk?sslmode=disable
DATA_DIR=/var/lib/busluk
SECRET=замените-на-длинную-случайную-строку
ADMIN_TOKEN=замените-на-пароль-модератора

# 1 = смотреть объявления можно только после входа по SMS; 0 = смотреть могут все (номер продавца — только вошедшим)
REQUIRE_LOGIN=1

# Тестовый вход для проверки в App Store / Google Play (код по SMS не отправляется)
DEMO_PHONE=+99365000000
DEMO_CODE=246810

# ---- SMS: SMPP оператора (TMCell / Altyn Asyr) ----
SMPP_HOST=
SMPP_PORT=2775
SMPP_USER=
SMPP_PASS=
SMPP_SYSTEM_TYPE=
SMPP_SRC=Busluk        # имя отправителя (согласовать с оператором)
SMPP_SRC_TON=5         # 5 = буквенное имя; для цифрового номера: 1
SMPP_SRC_NPI=0

# ---- Эквайринг банка (REST: register.do / getOrderStatusExtended.do) ----
# адрес, логин и пароль выдаёт банк по договору; без них работает тестовый режим
PAY_URL=
PAY_USER=
PAY_PASS=
PAY_CURRENCY=934       # TMT
PAY_MULT=100           # манат -> тенге
PAY_MOCK=0

# ---- цены услуг, TMT ----
PRICE_BUMP=10
PRICE_VIP7=50
PRICE_VIP30=150
